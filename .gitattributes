# 关键：lib/client.js 内含大段 base64 与模板字符串（含 CSS 里的转义、反引号边界），
# 任何行尾转换或 diff 归一化都可能破坏它。强制按二进制处理并禁用 diff。
lib/client.js   -text -diff

# 其余文本文件统一 LF（仓库侧），检出时由各平台自行决定
*.js            text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.css           text eol=lf

# 二进制资源
*.png           binary
*.webp          binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.tgz           binary

# 许可正文原样保留（含 CC 官方排版）
LICENSE-ARTWORK text eol=lf
