{
  "name": "@kdnoesr/maid-companions",
  "version": "0.6.0",
  "description": "左右鲸鱼娘女仆立绘 + 液态玻璃（v0.5.0 统一材质：输入框为基准，浮层/面板/控件共用一套折射与模糊语言）",
  "type": "module",
  "main": "./lib/index.js",
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "maid",
    "companion",
    "liquid-glass",
    "ui"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  }
}
